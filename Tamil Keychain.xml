    <pluginDef name="Simple Array Preview"><![CDATA[var plugin = {
  name: "Simple Array Preview",
  controls: [
    { key: "count", label: "Count", type: "range", min: 1, max: 10, step: 1, default: 3 },
    { key: "spacing", label: "Spacing", type: "range", min: 1, max: 50, step: 1, default: 20 }
  ],

  apply: function (obj, params, THREE) {
    if (!obj || !obj.geometry) return;

    var count = Math.max(1, Math.round(params.count || 1));
    var spacing = params.spacing || 20;
    var baseGeo = obj.geometry;

    // Collect all attribute names and check for index
    var attrNames = Object.keys(baseGeo.attributes);
    var isIndexed = baseGeo.index !== null;
    var baseIndex = isIndexed ? baseGeo.index : null;
    var vertCount = baseGeo.getAttribute("position").count;
    var indexCount = isIndexed ? baseIndex.count : 0;

    // Prepare merged attribute arrays
    var mergedAttrs = {};
    attrNames.forEach(function (name) {
      var attr = baseGeo.getAttribute(name);
      mergedAttrs[name] = {
        array: new Float32Array(count * attr.count * attr.itemSize),
        itemSize: attr.itemSize
      };
    });

    var mergedIndex = isIndexed ? new Uint32Array(count * indexCount) : null;

    for (var i = 0; i < count; i++) {
      var offsetX = i * spacing;

      attrNames.forEach(function (name) {
        var srcAttr = baseGeo.getAttribute(name);
        var dst = mergedAttrs[name].array;
        var itemSize = srcAttr.itemSize;
        var baseOffset = i * srcAttr.count * itemSize;

        for (var v = 0; v < srcAttr.count; v++) {
          for (var c = 0; c < itemSize; c++) {
            var val = srcAttr.array[v * itemSize + c];
            // Only offset the X component of position
            if (name === "position" && c === 0) val += offsetX;
            dst[baseOffset + v * itemSize + c] = val;
          }
        }
      });

      // Copy indices with vertex offset
      if (isIndexed) {
        var idxOffset = i * indexCount;
        var vertOffset = i * vertCount;
        for (var j = 0; j < indexCount; j++) {
          mergedIndex[idxOffset + j] = baseIndex.array[j] + vertOffset;
        }
      }
    }

    // Build merged geometry
    var merged = new THREE.BufferGeometry();
    attrNames.forEach(function (name) {
      merged.setAttribute(name, new THREE.Float32BufferAttribute(
        mergedAttrs[name].array, mergedAttrs[name].itemSize
      ));
    });
    if (mergedIndex) {
      merged.setIndex(new THREE.BufferAttribute(mergedIndex, 1));
    }

    obj.geometry.dispose();
    obj.geometry = merged;

    if (typeof window !== "undefined" && window.updateLivePreview) {
      window.updateLivePreview();
    }
  },

  reset: function (obj, THREE) {}
};

return plugin;
]]></pluginDef>
